#!/usr/bin/env python3
"""Refuse a commit that carries a secret.

The key lives outside the repo by construction, which is the real defence. This is the second
one, for the day something is pasted into a file by accident - a debug print, a curl command
copied into a comment, a fixture built from a real key rather than a fake one.

It reads the STAGED content, not the working tree: what is about to be committed is not
necessarily what is on disk.

Install:  git config core.hooksPath .githooks
Bypass:   git commit --no-verify   (deliberate, and it tells you that is what you did)
"""
import os
import subprocess
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.abspath(__file__))))
try:
    from boardofdirectors import redact
except Exception:
    sys.exit(0)          # never block a commit because the hook itself broke

ALLOW_FIXTURES = ("tests/", "README.md", "CHANGELOG.md", ".githooks/")


def staged() -> list[str]:
    out = subprocess.run(["git", "diff", "--cached", "--name-only", "--diff-filter=ACM"],
                         capture_output=True, text=True).stdout
    return [f for f in out.split("\n") if f.strip()]


def content(path: str) -> str:
    """Staged bytes as text, or "" if it is not text at all.

    Read as BYTES. `text=True` here decoded whatever git handed back as UTF-8, so the first
    PNG added to the repo crashed the hook and took a perfectly good commit down with it -
    the exact failure this file's own docstring says must never happen. A guard that can
    block work it was not built to judge gets switched off, and then guards nothing.
    """
    r = subprocess.run(["git", "show", f":{path}"], capture_output=True)
    if r.returncode != 0:
        return ""
    raw = r.stdout
    if b"\x00" in raw[:4096]:
        return ""                     # binary: nothing here can look like a key
    try:
        return raw.decode("utf-8")
    except UnicodeDecodeError:
        return raw.decode("utf-8", errors="replace")


def main() -> int:
    findings = []
    for path in staged():
        if path.startswith(ALLOW_FIXTURES):
            continue          # these hold deliberate examples; the suite checks them instead
        for f in redact.scan(content(path)):
            if f.rule in ("dotenv path", "home path"):
                continue
            findings.append((path, str(f)))
    if not findings:
        return 0
    print("\n  COMMIT REFUSED - something staged looks like a secret:\n")
    for path, what in findings[:20]:
        print(f"    {path}: {what}")
    print("\n  Nothing was committed. Remove it, or `git commit --no-verify` if you are")
    print("  certain it is a fixture - but then say so in the commit message.\n")
    return 1


if __name__ == "__main__":
    try:
        raise SystemExit(main())
    except SystemExit:
        raise
    except Exception as e:                                        # noqa: BLE001
        # Belt and braces on the same principle: a scanner that crashes must fail OPEN. It
        # is the second line of defence, not the first - the key lives outside the repo -
        # so blocking real work because the scanner broke is the worse error.
        print(f"  (secret scan skipped: {type(e).__name__}: {e})")
        raise SystemExit(0) from None
